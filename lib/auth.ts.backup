'use server'

import { prisma } from './prisma'
import bcrypt from 'bcryptjs'
import crypto from 'crypto'
import { cookies } from 'next/headers'

// Types
export interface AdminUser {
  id: string
  username: string
  passwordHash: string
  role: string
  createdAt: Date
  updatedAt: Date
  sessionId?: string
}

export interface SessionData {
  id: string
  token: string
  adminId: string
  expiresAt: Date
  admin: AdminUser
}

// Constants
const SESSION_COOKIE_NAME = 'admin-session'
const SESSION_DURATION_MS = 24 * 60 * 60 * 1000 // 24 hours in milliseconds
const SESSION_DURATION_SECONDS = 24 * 60 * 60 // 24 hours in seconds

// ================================
// UTILITY FUNCTIONS
// ================================

export async function hashPassword(password: string): Promise<string> {
  try {
    return await bcrypt.hash(password, 12)
  } catch (error) {
    console.error('Hash password error:', error)
    throw new Error('Failed to hash password')
  }
}

export async function verifyPassword(password: string, hash: string): Promise<boolean> {
  try {
    return await bcrypt.compare(password, hash)
  } catch (error) {
    console.error('Verify password error:', error)
    return false
  }
}

// Server-side secure token generation
export async function generateSecureToken(): Promise<string> {
  return crypto.randomBytes(32).toString('hex')
}

// Server-side expiration calculation
export async function calculateExpirationTime(): Promise<Date> {
  return new Date(Date.now() + SESSION_DURATION_MS)
}

// ================================
// AUTHENTICATION FUNCTIONS
// ================================

export async function authenticateAdmin(username: string, password: string): Promise<AdminUser | null> {
  try {
    // Check hardcoded demo admin first
    if (username === 'admin' && password === 'SecureDemo2024!') {
      // Create a demo admin in database if not exists
      let demoAdmin = await prisma.admin.findUnique({
        where: { username: 'admin' }
      })
      
      if (!demoAdmin) {
        const hashedPassword = await bcrypt.hash('SecureDemo2024!', 12)
        demoAdmin = await prisma.admin.create({
          data: {
            username: 'admin',
            passwordHash: hashedPassword,
            role: 'admin'
          }
        })
      }
      
      return demoAdmin
    }

    // Check database admin
    const admin = await prisma.admin.findUnique({ 
      where: { username } 
    })
    
    if (!admin) return null

    const isValidPassword = await bcrypt.compare(password, admin.passwordHash)
    if (!isValidPassword) return null

    return admin
  } catch (error) {
    console.error('Authentication error:', error)
    return null
  }
}

// ================================
// SESSION MANAGEMENT
// ================================

export async function createSession(adminId: string): Promise<string> {
  try {
    // Generate secure random token using server-side utility
    const token = await generateSecureToken()
    
    // Calculate expiration using server-side utility
    const expiresAt = await calculateExpirationTime()

    // Clean up expired sessions for this admin first
    await cleanupExpiredSessions()
    await prisma.session.deleteMany({
      where: {
        adminId,
        expiresAt: { lte: new Date() }
      }
    })

    // Create new session in database
    const session = await prisma.session.create({
      data: {
        token,
        adminId,
        expiresAt
      }
    })

    return session.token
  } catch (error) {
    console.error('Create session error:', error)
    throw new Error('Failed to create session')
  }
}

export async function getSessionByToken(token: string): Promise<SessionData | null> {
  try {
    if (!token) return null

    // Get session from database
    const session = await prisma.session.findUnique({
      where: { token },
      include: { admin: true }
    })

    if (!session) return null

    // Check if session is expired
    if (session.expiresAt <= new Date()) {
      // Clean up expired session
      await prisma.session.delete({
        where: { id: session.id }
      })
      return null
    }

    return session
  } catch (error) {
    console.error('Get session error:', error)
    return null
  }
}

export async function deleteSession(token: string): Promise<void> {
  try {
    if (!token) return

    // Delete from database
    await prisma.session.deleteMany({
      where: { token }
    })
  } catch (error) {
    console.error('Delete session error:', error)
  }
}

export async function deleteAllUserSessions(adminId: string): Promise<void> {
  try {
    // Delete all sessions for this admin
    await prisma.session.deleteMany({
      where: { adminId }
    })
  } catch (error) {
    console.error('Delete all sessions error:', error)
  }
}

// ================================
// COOKIE MANAGEMENT
// ================================

export async function setSessionCookie(token: string): Promise<void> {
  try {
    const cookieStore = await cookies()
    
    cookieStore.set(SESSION_COOKIE_NAME, token, {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: SESSION_DURATION_SECONDS,
      path: '/',
      // Additional security options
      priority: 'high'
    })
  } catch (error) {
    console.error('Set session cookie error:', error)
    throw new Error('Failed to set session cookie')
  }
}

export async function clearSessionCookie(): Promise<void> {
  try {
    const cookieStore = await cookies()
    cookieStore.set(SESSION_COOKIE_NAME, '', {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: 0,
      path: '/'
    })
  } catch (error) {
    console.error('Clear session cookie error:', error)
  }
}

export async function getSessionFromCookie(): Promise<SessionData | null> {
  try {
    const cookieStore = await cookies()
    const token = cookieStore.get(SESSION_COOKIE_NAME)?.value
    
    if (!token || token === '') return null
    
    return await getSessionByToken(token)
  } catch (error) {
    console.error('Get session from cookie error:', error)
    return null
  }
}

// ================================
// CURRENT USER
// ================================

export async function getCurrentAdmin(): Promise<AdminUser | null> {
  try {
    const session = await getSessionFromCookie()
    return session ? session.admin : null
  } catch (error) {
    console.error('Get current admin error:', error)
    return null
  }
}

export async function requireAdmin(): Promise<AdminUser> {
  const admin = await getCurrentAdmin()
  if (!admin) {
    throw new Error('Authentication required')
  }
  return admin
}

// ================================
// UTILITY FUNCTIONS
// ================================

export async function hashPassword(password: string): Promise<string> {
  try {
    return await bcrypt.hash(password, 12)
  } catch (error) {
    console.error('Hash password error:', error)
    throw new Error('Failed to hash password')
  }
}

export async function verifyPassword(password: string, hash: string): Promise<boolean> {
  try {
    return await bcrypt.compare(password, hash)
  } catch (error) {
    console.error('Verify password error:', error)
    return false
  }
}

// ================================
// CLEANUP FUNCTIONS
// ================================

export async function cleanupExpiredSessions(): Promise<void> {
  try {
    const result = await prisma.session.deleteMany({
      where: {
        expiresAt: { lte: new Date() }
      }
    })
    console.log(`Cleaned up ${result.count} expired sessions`)
  } catch (error) {
    console.error('Cleanup sessions error:', error)
  }
}

// ================================
// SESSION VALIDATION
// ================================

export async function validateSession(token: string): Promise<boolean> {
  try {
    const session = await getSessionByToken(token)
    return session !== null
  } catch (error) {
    console.error('Validate session error:', error)
    return false
  }
}

