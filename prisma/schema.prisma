// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Model untuk data pendaftar/calon siswa
model Pendaftar {
  id                String   @id @default(cuid())
  noPendaftaran     String   @unique @map("no_pendaftaran")
  nama              String // Nama Lengkap
  nik               String   @unique // NIK (Nomor Induk Kependudukan)
  tempatLahir       String   @map("tempat_lahir") // Tempat Lahir
  tanggalLahir      DateTime @map("tanggal_lahir") // Tanggal Lahir
  jenisKelamin      String   @map("jenis_kelamin") // Jenis Kelamin (Laki-laki/Perempuan)
  agama             String // Agama
  anakKe            String?  @map("anak_ke") // Anak Ke
  jumlahSaudara     String?  @map("jumlah_saudara") // Jumlah Saudara
  alamat            String   @db.Text // Alamat Lengkap
  jalurPendaftaran  String   @map("jalur_pendaftaran") // Jalur Pendaftaran
  asalSekolah       String?  @map("asal_sekolah") // Asal Sekolah (TK/RA)
  prestasi          String?  @db.Text // Prestasi (khusus untuk jalur prestasi)
  statusPendaftaran String   @default("draft") @map("status_pendaftaran") // draft, submit, review, accepted, rejected
  tanggalDaftar     DateTime @default(now()) @map("tanggal_daftar")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  orangTua OrangTua[]
  dokumen  Dokumen[]

  @@map("pendaftar")
}

model OrangTua {
  id            String   @id @default(cuid())
  pendaftarId   String   @map("pendaftar_id")
  namaAyah      String   @map("nama_ayah") // Nama Ayah
  pekerjaanAyah String?  @map("pekerjaan_ayah") // Pekerjaan Ayah
  namaIbu       String   @map("nama_ibu") // Nama Ibu
  pekerjaanIbu  String?  @map("pekerjaan_ibu") // Pekerjaan Ibu
  noTelp        String   @map("no_telp") // Nomor Telepon
  email         String? // Email
  alamatOrtu    String?  @map("alamat_ortu") @db.Text // Alamat Orang Tua (jika berbeda dengan anak)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  pendaftar Pendaftar @relation(fields: [pendaftarId], references: [id], onDelete: Cascade)

  @@map("orang_tua")
}

model Dokumen {
  id           String   @id @default(cuid())
  pendaftarId  String   @map("pendaftar_id")
  jenisDokumen String   @map("jenis_dokumen") // foto, ijazah, kk, akta_lahir, sertifikat
  namaFile     String   @map("nama_file")
  ukuranFile   Int      @map("ukuran_file") // dalam bytes
  pathFile     String   @map("path_file")
  status       String   @default("pending") // pending, approved, rejected
  keterangan   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  pendaftar Pendaftar @relation(fields: [pendaftarId], references: [id], onDelete: Cascade)

  @@map("dokumen")
}

// Model untuk admin system
model Admin {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String // hashed password
  nama      String // Nama lengkap admin
  email     String?   @unique
  role      String    @default("admin") // admin, super_admin
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions AdminSession[]

  @@map("admin")
}

// Model untuk session management
model AdminSession {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_session")
}

// Model untuk pengaturan PPDB yang dinamis
model PPDBSettings {
  id                String   @id @default(cuid())
  tahunAjaran       String   @map("tahun_ajaran") // 2025/2026
  statusPendaftaran String   @default("tutup") @map("status_pendaftaran") // buka, tutup
  tanggalBuka       DateTime @map("tanggal_buka")
  tanggalTutup      DateTime @map("tanggal_tutup")
  kuotaSiswa        Int      @default(0) @map("kuota_siswa")
  persyaratan       String[] @default([]) // Array of requirements
  alurPendaftaran   String[] @default([]) @map("alur_pendaftaran") // Array of steps
  informasiTambahan String?  @map("informasi_tambahan") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ppdb_settings")
}

// Model untuk konten website yang dinamis
model Content {
  id        String   @id @default(cuid())
  key       String   @unique // hero_title, hero_subtitle, announcement_main, etc
  content   String   @db.Text
  type      String   @default("text") // text, html, json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}

// Model untuk pengumuman
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  type        String    @default("info") // info, warning, success, error
  isPublished Boolean   @default(false) @map("is_published")
  publishDate DateTime? @map("publish_date")
  expiryDate  DateTime? @map("expiry_date")
  priority    Int       @default(0) // Higher number = higher priority
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("announcement")
}
